APP_NAME=WarungU
APP_ENV=local
APP_KEY=
# Saat dipublikasikan WAJIB: APP_ENV=production dan APP_DEBUG=false
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dbwarungu
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Saat dipublikasikan (HTTPS) WAJIB true agar cookie sesi hanya dikirim lewat HTTPS
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Password akun demo untuk "php artisan db:seed".
# Kosongkan = dibuat acak dan ditampilkan sekali di terminal.
SEED_PASSWORD_PEMILIK=
SEED_PASSWORD_PEGAWAI=
